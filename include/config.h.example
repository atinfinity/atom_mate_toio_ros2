// このファイルを config.h にコピーして環境に合わせて編集してください。
// config.h は .gitignore 対象です。
#pragma once

// Wi-Fi 接続情報
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// micro-ros-agent を動かす PC の IP アドレスとポート
#define AGENT_IP      "192.168.1.100"
#define AGENT_PORT    8888

// ROS 2 設定
#define ROS_NAMESPACE ""                // ノードの名前空間(通常は空でよい)

// 配信モード(どちらか一方のみ配信される)
//   PUBLISH_MODE_RANGE: sensor_msgs/Range を RANGE_TOPIC_NAME に配信
//   PUBLISH_MODE_SCAN:  sensor_msgs/LaserScan(1ビーム)を SCAN_TOPIC_NAME に配信
#define PUBLISH_MODE_RANGE 0
#define PUBLISH_MODE_SCAN  1
#define PUBLISH_MODE PUBLISH_MODE_RANGE

#define RANGE_TOPIC_NAME "toio/range"
#define SCAN_TOPIC_NAME  "toio/scan"
#define FRAME_ID         "toio_range_link"

// publish 周期 [ms](100ms = 10Hz)
#define PUBLISH_PERIOD_MS 100
